{
    "env": {
      "browser": true,
      "node": true,
      "es2021": true
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
      // "project": ["./frontend/tsconfig.json"]
    },
    "plugins": ["@typescript-eslint", "react", "react-hooks"],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "prettier"
    ],
    "rules": {
      "no-console": "warn",
      "semi": ["error", "always"],
      "quotes": ["error", "single"]
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }
  